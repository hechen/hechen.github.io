&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#66d9ef&#34;&gt;let&lt;/span&gt; storeURL = URL.storeURL(&lt;span style=&#34;color:#66d9ef&#34;&gt;for&lt;/span&gt;: Constants.groupContainerName, databaseName: &lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#34;Sideloader&amp;#34;&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#66d9ef&#34;&gt;let&lt;/span&gt; storeDescription = NSPersistentStoreDescription(url: storeURL)
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;storeDescription.cloudKitContainerOptions = NSPersistentCloudKitContainerOptions(containerIdentifier: &lt;span style=&#34;color:#e6db74&#34;&gt;&amp;#34;iCloud.app.chen.ios.Sideloader&amp;#34;&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;container.persistentStoreDescriptions = [storeDescription]
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;container.viewContext.automaticallyMergesChangesFromParent = &lt;span style=&#34;color:#66d9ef&#34;&gt;true&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
