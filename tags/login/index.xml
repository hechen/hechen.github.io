&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;        DistributedNotificationCenter.&lt;span style=&#34;color:#66d9ef&#34;&gt;default&lt;/span&gt;().addObserver(&lt;span style=&#34;color:#66d9ef&#34;&gt;self&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;                                                                selector: &lt;span style=&#34;color:#66d9ef&#34;&gt;#selector&lt;/span&gt;(&lt;span style=&#34;color:#66d9ef&#34;&gt;self&lt;/span&gt;.terminate),
